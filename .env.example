# Prism Hub Environment Example
# Copy this file to .env and fill in your values

# Application
APP_NAME=Prism Hub
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000

# Database (SQLite for development, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./prism_hub.db
# DATABASE_URL=postgresql+asyncpg://user:password@db:5432/prism_hub

# OIDC / Keycloak
OIDC_ISSUER_URL=http://keycloak:8080/realms/prism-hub
OIDC_CLIENT_ID=prism-hub-backend
OIDC_CLIENT_SECRET=your-client-secret-here
OIDC_AUDIENCE=prism-hub-api

# LLM Provider (openai-compatible, anthropic, gemini, ollama)
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_API_KEY=

# CORS Origins (comma-separated or JSON array)
CORS_ORIGINS=["https://your-domain.com"]

# Demo Mode - MUST be false in production!
# The backend will REFUSE to start with DEMO_MODE=true in production
DEMO_MODE=false